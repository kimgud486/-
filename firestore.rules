rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /strategies/{strategyId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /positions/{positionId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /trades/{tradeId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /orders/{orderId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /ai_analyses/{analysisId} {
      allow read, write: if true;
    }
    match /ai_loss_analytics/{lossId} {
      allow read, write: if true;
    }
    match /ai_model_upgrades/{upgradeId} {
      allow read, write: if true;
    }
    match /positions_trailing_v138/{docId} {
      allow read, write: if true;
    }
  }
}
