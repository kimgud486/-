# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# KIS LIVE TRADING - server only
# Never expose these values to the browser bundle.
# -----------------------------------------------------------------------------
KIS_APPKEY=""
KIS_APPSECRET=""
KIS_CANO=""
KIS_ACNT_PRDT_CD="01"

# Explicit server kill-gate. LIVE orders are rejected unless exactly "true".
AISTOCK_ALLOW_LIVE_TRADING="false"

# Independent server-side risk caps. Browser values cannot raise these limits.
AISTOCK_MAX_LIVE_ORDER_KRW="5000000"
AISTOCK_MAX_LIVE_PRICE_DEVIATION="0.03"
